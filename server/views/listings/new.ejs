<% layout('layouts/boilerplate') -%>

 <div class="container mt-2">
    <div class="row">
      <div class="col-8 offset-2 ">
        <h3>Create New Listing</h3>
        <form action="/listings"  method="POST" novalidate class="needs-validation" enctype="multipart/form-data"   >
          <div class="mb-2">
            <label for="title" class="form-label">Title:</label>
            <input type="text" id="title" name="listing[title]" class="form-control" required placeholder="Enter title" />
             <div class="valid-feedback">
                Great! The title is set. 
              </div>
          </div>
          <div class="mb-2">
            <label for="description" class="form-label">Description:</label>
            <textarea id="description" name="listing[description]" required class="form-control"></textarea>
             <div class="invalid-feedback">
                Please enter a short description
              </div>
          </div>
          <div class="mb-2">
            <label for="image" class="form-label">Upload Listing image:</label>
            <input type="file" id="image" name="listing[image]" class="form-control" placeholder="Enter image url/link" />
             <div class="valid-feedback">
               Choose right image path
              </div>
          </div>

         <div class="row">
           <div class="mb-2 col-md-4">
            <label for="price" class="form-label">Price:</label>
            <input  id="price" name="listing[price]" class="form-control" required placeholder=" ₹ 1200" />
            <div class="invalid-feedback">
               Enter a valid price.
              </div>
          </div>

          <div class="mb-2 col-md-8">
            <label for="location" class="form-label">Location:</label>
            <input type="text" id="location" name="listing[location]" class="form-control" required placeholder="Noida / Jaiypur" />
             <div class="invalid-feedback">
               Enter a valid location name
              </div>
          </div>
         </div>

          <div class="mb-3">
            <label for="country" class="form-label">Country:</label>
            <input type="text" id="country" name="listing[country]" class="form-control" required  placeholder="India"/>
            <div class="invalid-feedback">
               Enter a valid country name
              </div>
          </div>

          <div class="mb-3">
            <button type="submit" class="btn btn-danger">Add Listing</button>
          </div>
        </form>
      </div>
    </div>
  </div>
   
